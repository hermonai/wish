[Desktop Entry]
# The version of the desktop entry spec this conforms to.
Version=1.0

Type=Application

Name=WishOss
GenericName=TerminalEmulator

Exec=wish-terminal-oss %U
StartupWMClass=ai.hermon.WishOss

Keywords=shell;prompt;command;commandline;cmd;

Icon=ai.hermon.WishOss

Categories=System;TerminalEmulator;

# Don't run this application within a terminal.
Terminal=false

# Register ourselves as the handler for wishoss:// URLs.
MimeType=x-scheme-handler/wishoss;
