[Desktop Entry]
# The version of the desktop entry spec this conforms to.
Version=1.0

Type=Application

Name=Wish
GenericName=TerminalEmulator

Exec=wish-terminal %U
StartupWMClass=ai.hermon.Wish

Keywords=shell;prompt;command;commandline;cmd;

Icon=ai.hermon.Wish

Categories=System;TerminalEmulator;

# Don't run this application within a terminal.
Terminal=false

# Register ourselves as the handler for wish:// URLs.
MimeType=x-scheme-handler/wish;
