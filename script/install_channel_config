#!/usr/bin/env bash
#
# Channel config installation stub.
#
# The original Warp project used a private `warp-channel-config` binary to
# generate per-channel build configs at runtime. The Wish fork does not use
# this binary — all Wish channels are configured inline (see oss.rs, dev.rs,
# etc.). This script exists only as a no-op so that `./script/run` does not
# break for developers who have existing workflows.
#
# For internal (non-OSS) builds that need dynamic config generation, a future
# `wish-channel-config` tool will be provided.

echo "Channel config: Wish uses inline channel configuration. Skipping external config binary."
echo "  → The OSS binary (wish-oss) will be used. See app/src/bin/oss.rs for config."
exit 0
